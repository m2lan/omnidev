# =============================================================================
# OmniDev — AI knowledge & coding workbench
# One backend binary (apps/gateway): auth + chat + knowledge engine + agent.
# Copy to .env and fill in the values you use; every entry is optional unless
# noted otherwise.
# =============================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=9090
APP_LOG_LEVEL=debug

# --- PostgreSQL (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=omnidev
DB_PASSWORD=omnidev
DB_NAME=omnidev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# --- Redis (rate limiting, caches, usage counters) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- MinIO (attachments; omit to disable uploads) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# --- JWT (required) ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=omnidev

# --- AI providers (only providers with a key are registered) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=
QWEN_API_KEY=
AI_DEFAULT_MODEL=deepseek-chat

# --- Knowledge engine (embedded in the gateway) ---
# Provider: openai | gemini | ollama
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
# Storage: local | minio
KNOWLEDGE_STORAGE_TYPE=local
KNOWLEDGE_LOCAL_PATH=./data/knowledge
KNOWLEDGE_BUCKET=knowledge
KNOWLEDGE_PARSER_TYPE=tika
KNOWLEDGE_CACHE_TTL=10m
# 0 = infer from the embedding model response
KNOWLEDGE_EMBEDDING_DIMENSIONS=0

# --- Tika (document parsing for chat attachments and knowledge bases) ---
TIKA_ENDPOINT=http://localhost:9998
TIKA_TIMEOUT=30

# --- External MCP servers available to chat ---
MCP_ENABLED=false
# JSON array: [{"name":"knowledge","url":"http://localhost:9100/mcp","api_key":"","timeout_seconds":15}]
MCP_SERVERS=

# --- Background agent (Docker sandbox) ---
SANDBOX_ENABLED=true
SANDBOX_WORKSPACE_ROOT=./data/agent-workspaces
# Only needed when the gateway runs inside Docker: host path of the same directory
SANDBOX_HOST_WORKSPACE_ROOT=
SANDBOX_NETWORK=none
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT=120s
SANDBOX_PYTHON_IMAGE=python:3.12-alpine
SANDBOX_NODE_IMAGE=node:22-alpine
SANDBOX_GO_IMAGE=golang:1.22-alpine
SANDBOX_SHELL_IMAGE=alpine:3.19
# Planner model; falls back to OPENAI_* when unset
AGENT_MODEL=gpt-4o-mini
AGENT_BASE_URL=
AGENT_API_KEY=

# --- Security ---
ENCRYPTION_KEY=

# --- OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
